@page
@model IndexModel
@{
    ViewData["Title"] = "WeatherAppSweden";
}

<div class="text-center p-5">
    <h1 class="display-4 mb-4">WeatherAppSweden</h1>
    <p class="lead">Uppdaterad: @DateTime.Now:yyyy-MM-dd HH:mm</p>

    <table class="table table-striped table-hover w-75 mx-auto">
        <thead class="table-dark">
            <tr>
                <th>Stad</th>
                <th>Temp</th>
                <th>Regn</th>
                <th>Vind</th>
                <th>Ute-index</th>
                <th>Kommentar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.WeatherList)
            {
                <tr>
                    <td><strong>@c.City</strong></td>
                    <td>@c.Temperature °C</td>
                    <td>@c.Rain mm</td>
                    <td>@c.Wind m/s</td>
                    <td><strong>@c.OutdoorScore</strong></td>
                    <td>@c.Comment</td>
                </tr>
            }
        </tbody>
    </table>
</div>